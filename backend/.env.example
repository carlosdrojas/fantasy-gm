# ESPN session cookies (fantasy.espn.com -> DevTools -> Application -> Cookies).
# Copy the raw values; keep the curly braces on SWID. They expire every few weeks.
FGM_ESPN_S2=
FGM_ESPN_SWID=

# For the Assistant tab (console.anthropic.com -> API keys).
ANTHROPIC_API_KEY=

# Background sync interval (minutes). 0 disables it.
FGM_SYNC_INTERVAL_MINUTES=60

# While NFL games are on, refresh live scores this often (seconds). 0 disables it.
FGM_LIVE_INTERVAL_SECONDS=60

# Defaults to backend/data/fantasy_gm.db. Any SQLAlchemy URL works (e.g. Postgres).
# FGM_DATABASE_URL=sqlite:////absolute/path/fantasy_gm.db

# Public demo: serve only the built-in made-up league, refuse adding/syncing leagues,
# no background sync, no ESPN cookies needed.
# FGM_DEMO_MODE=true

# Accounts (a hosted, multi-user site). Leave unset for a single-user install.
# Clerk dashboard -> API keys -> Frontend API URL:
# FGM_AUTH_ISSUER=https://your-app.clerk.accounts.dev
# FGM_AUTH_AUTHORIZED_PARTIES=["https://your-site.vercel.app"]
# Encrypts users' ESPN cookies. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# FGM_SECRET_KEY=
